# Copy to .env (which is gitignored) and set real values in your deployment.

# Password for the admin panel (/admin). If unset, a random one is generated at
# startup and printed to the logs.
ADMIN_PASSWORD=

# Flask session secret. If unset, a random key is generated at startup
# (sessions won't persist across restarts). Set a stable value in production.
SECRET_KEY=

# Optional: Umami privacy-friendly analytics. Leave blank to disable.
UMAMI_SRC=
UMAMI_WEBSITE_ID=
