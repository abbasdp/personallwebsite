<div class="left-bar">
   <div class="left-bar__inner">
      <header class="header">
         <a class="logo" href="{{@website.url}}" title="{{@website.name}} — صفحهٔ اصلی">
            {{#if @website.logo}}
               <img
                  src="{{@website.logo}}"
                  alt="{{@website.name}}"
                  width="{{@website.logoSize.width}}"
                  height="{{@website.logoSize.height}}"
                  decoding="async">
            {{else}}
               {{@website.name}}
            {{/if}}
         </a>

         {{#if menus.mainMenu}}
            {{> menu menus.mainMenu}}
         {{/if}}
      </header>
   </div>
</div>
